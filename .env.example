# API-ключ Bybit для торговли.
BYBIT_API_KEY=your_api_key
# API-секрет Bybit для торговли.
BYBIT_API_SECRET=your_api_secret

# Включает локальный admin UI в том же Node-процессе, что и бот.
ADMIN_ENABLED=false
# Хост admin UI. Для production оставляйте loopback-интерфейс.
ADMIN_HOST=127.0.0.1
# Локальный порт admin UI.
ADMIN_PORT=3080
# Логин для входа в admin UI на странице http://127.0.0.1:3080/admin/login.
ADMIN_USERNAME=admin
# Пароль для входа в admin UI. Задайте длинное случайное значение.
ADMIN_PASSWORD=replace-with-long-random-password
